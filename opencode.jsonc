{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": false,
        "codemode": false,
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["pnpx", "chrome-devtools-mcp@latest"],
      },
    },
  },
  "plugins": ["@dietrichgebert/ponytail"],
}
